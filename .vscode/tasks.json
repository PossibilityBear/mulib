// .vscode/tasks.json
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build debug",
            "type": "shell",
            "command": "cargo build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$rustc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}